let dorkParts=[];const TOOL_NAV={dorks:'search','web-search':'search',username:'search',wayback:'search',social:'search',ip:'network',dns:'network',domain:'network',asn:'network',crt:'network',metadata:'network',discord:'identifiers',telegram:'identifiers',email:'identifiers',phone:'identifiers'};
function showView(n){$$('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+n));$$('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.view===n));$('#sidebar').classList.remove('open');window.scrollTo({top:0,behavior:'smooth'})}
function renderDashboard(){const c=getCases(),h=GLORY.store.get('history',[]),notes=c.reduce((n,x)=>n+x.notes.length,0),s=GLORY.store.get('savedSearches',[]);$('#statsGrid').innerHTML=[['Cases',c.length],['Findings',notes],['Lookups',h.length],['Saved searches',s.length]].map(([k,v])=>`<div class="stat"><b>${v}</b><span>${k}</span></div>`).join('');const q=[['Google Dorks','dorks'],['Web search','web-search'],['Username lookup','username'],['Wayback','wayback'],['IP lookup','ip'],['DNS','dns'],['Domain / WHOIS','domain'],['Certificates','crt'],['Discord ID','discord'],['Email check','email']];$('#quickTools').innerHTML=q.map(([l,t])=>`<button data-goto="${TOOL_NAV[t]}" data-tool="${t}">${l}</button>`).join('');$('#recentActivity').innerHTML=h.slice(0,8).map(x=>`<li><b>${GLORY.escape(x.kind)}</b> — ${GLORY.escape(x.value||'')}<br><small>${GLORY.prettyDate(x.time)}</small></li>`).join('')||'<li>No activity yet.</li>';renderCases()}
function renderHistory(){const h=GLORY.store.get('history',[]);$('#historyList').innerHTML=h.slice(0,50).map(x=>`<li><b>${GLORY.escape(x.kind)}</b> — ${GLORY.escape(x.value||'')}<br><small>${GLORY.prettyDate(x.time)}</small></li>`).join('')||'<li>No history yet.</li>';const s=GLORY.store.get('savedSearches',[]);$('#savedSearches').innerHTML=s.map(x=>`<a href="${GLORY.escape(x.url)}" target="_blank" rel="noopener">${GLORY.escape(x.name)}</a>`).join('')||'<p>No saved searches.</p>'}
function updateDorkPreview(){const t=$('#dorkTerm').value.trim(),o=$('#dorkOperator').value,v=$('#dorkValue').value.trim();dorkParts=[t];if(o&&v)dorkParts.push(o+v);$('#dorkPreview').textContent=dorkParts.join(' ')}
function runDork(){updateDorkPreview();const q=dorkParts.join(' ').trim();if(!q)return GLORY.toast('Enter a search term.');GLORY.addHistory('Google dork',q,'');GLORY.open('https://www.google.com/search?q='+encodeURIComponent(q))}
function hashFiles(){const f=$('#hashFile').files,b=$('#hashResults');if(!f.length)return GLORY.toast('Choose files.');b.innerHTML='<p>Hashing…</p>';Promise.all([...f].map(async x=>[x.name,x.size,await sha256File(x)])).then(rows=>{b.innerHTML=GLORY.table(rows.map(([n,s,h])=>[n,`${s} bytes — SHA-256: ${h}`]));GLORY.addHistory('SHA-256 hashing',rows.length+' file(s)','')})}
document.addEventListener('click',e=>{const nav=e.target.closest('.nav-btn');if(nav)return showView(nav.dataset.view);const go=e.target.closest('[data-goto]');if(go){showView(go.dataset.goto);const t=$(`[data-tool="${go.dataset.tool}"]`);if(t)t.scrollIntoView({behavior:'smooth',block:'center'});return}const a=e.target.closest('[data-action]');if(!a)return;const x=a.dataset.action;
if(x==='add-dork')updateDorkPreview();if(x==='run-dork')runDork();
if(x==='web-search'){const q=$('#webQuery').value.trim();if(!q)return GLORY.toast('Enter a query.');GLORY.addHistory('Web search',q,'');GLORY.open($('#webEngine').value+encodeURIComponent(q))}
if(x==='username-lookup')renderUsernameResults();if(x==='social-search')renderSocialResults();
if(x==='wayback-lookup')runWayback(false);if(x==='wayback-open')runWayback(true);
if(x==='ip-lookup')runIp();if(x==='dns-lookup')runDns();if(x==='domain-lookup')runDomain();if(x==='asn-lookup')runASN();if(x==='crt-lookup')runCrt();if(x==='metadata-lookup')runMetadata();if(x==='discord-lookup')runDiscord();if(x==='telegram-lookup')runTelegram();if(x==='email-validate')runEmail();if(x==='phone-validate')runPhone();if(x==='address-validate')runAddress();if(x==='name-search')runNameSearch();
if(x==='create-case')createCase($('#caseTitle').value,$('#caseTags').value);
if(x==='add-note')addNote($('#noteCase').value,$('#noteTitle').value,$('#noteBody').value,$('#noteSource').value);
if(x==='export-report'){const id=$('#noteCase').value||activeCaseId();id?exportReport(id):GLORY.toast('Select a case.')}
if(x==='hash-files')hashFiles();
if(x==='clear-history'){if(confirm('Clear history?')){GLORY.store.set('history',[]);renderHistory();renderDashboard()}}
if(x==='save-search'){const n=$('#savedSearchName').value.trim(),u=$('#savedSearchUrl').value.trim();if(!n||!u)return GLORY.toast('Enter name and URL.');const s=GLORY.store.get('savedSearches',[]);s.unshift({name:n,url:u,time:GLORY.now()});GLORY.store.set('savedSearches',s.slice(0,100));$('#savedSearchName').value='';$('#savedSearchUrl').value='';renderHistory()}
const o=e.target.closest('[data-open]');if(o)setActiveCase(o.dataset.open);const ex=e.target.closest('[data-export]');if(ex)exportReport(ex.dataset.export);const de=e.target.closest('[data-delete]');if(de)deleteCase(de.dataset.delete)});
document.addEventListener('input',e=>{if(['dorkTerm','dorkOperator','dorkValue'].includes(e.target.id))updateDorkPreview()});
$('#menuBtn').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));
$('#newCaseBtn').addEventListener('click',()=>{const t=prompt('Case title:');if(t)createCase(t,'')});
$('#globalSearch').addEventListener('input',e=>{const q=e.target.value.toLowerCase().trim();$$('.tool-card').forEach(c=>{const m=!q||c.textContent.toLowerCase().includes(q);c.style.display=m?'':'none';const v=c.closest('.view');if(q&&m)v.classList.add('active');else if(q)v.classList.remove('active')});if(!q)showView('dashboard')});
renderDashboard();renderHistory();renderCases();renderNotes();
