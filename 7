const COUNTRY_CODES={'+1':'US/CA','+44':'UK','+61':'Australia','+62':'Indonesia','+65':'Singapore','+81':'Japan','+91':'India','+49':'Germany','+33':'France','+234':'Nigeria'};
function usernamePlatforms(u){const e=encodeURIComponent(u);return[['GitHub',`https://github.com/${e}`],['X / Twitter',`https://x.com/${e}`],['Instagram',`https://www.instagram.com/${e}/`],['TikTok',`https://www.tiktok.com/@${e}`],['YouTube',`https://www.youtube.com/@${e}`],['Reddit',`https://www.reddit.com/user/${e}`],['Telegram',`https://t.me/${e}`],['Twitch',`https://www.twitch.tv/${e}`],['Pinterest',`https://www.pinterest.com/${e}/`],['Medium',`https://medium.com/@${e}`],['Keybase',`https://keybase.io/${e}`],['Gravatar',`https://gravatar.com/${e}`]]}
function socialPlatforms(q){const e=encodeURIComponent(q);return[['X / Twitter',`https://x.com/search?q=${e}`],['Reddit',`https://www.reddit.com/search/?q=${e}`],['YouTube',`https://www.youtube.com/results?search_query=${e}`],['Facebook',`https://www.facebook.com/search/top?q=${e}`],['LinkedIn',`https://www.linkedin.com/search/results/all/?keywords=${e}`],['TikTok',`https://www.tiktok.com/search?q=${e}`]]}
function renderUsernameResults(){const u=$('#usernameInput').value.trim(),b=$('#usernameResults');if(!u)return GLORY.toast('Enter a username.');b.innerHTML=usernamePlatforms(u).map(([n,u2])=>`<a href="${u2}" target="_blank" rel="noopener">${n}</a>`).join('');GLORY.addHistory('Username lookup',u,'')}
function renderSocialResults(){const q=$('#socialQuery').value.trim(),b=$('#socialResults');if(!q)return GLORY.toast('Enter a search term.');b.innerHTML=socialPlatforms(q).map(([n,u])=>`<a href="${u}" target="_blank" rel="noopener">${n}</a>`).join('');GLORY.addHistory('Social search',q,'')}
async function runWayback(openOnly){const u=$('#waybackUrl').value.trim();if(!u)return GLORY.toast('Enter a URL.');GLORY.addHistory('Wayback lookup',u,'');if(openOnly)return GLORY.open('https://web.archive.org/web/*/'+u);const b=$('#waybackResult');b.innerHTML='<p>Checking Internet Archive…</p>';try{const d=await waybackAvailable(u),s=d?.archived_snapshots?.closest;b.innerHTML=s?`<p><b>Closest snapshot:</b> <a href="${s.url}" target="_blank" rel="noopener">${GLORY.escape(s.url)}</a></p>`:'<p>No public snapshot returned.</p>'}catch(e){b.innerHTML='<p>Wayback service unavailable.</p>'}}
async function runIp(){const ip=$('#ipInput').value.trim(),b=$('#ipResult');b.innerHTML='<p>Querying…</p>';try{const d=await ipLookup(ip);GLORY.addHistory('IP lookup',d.ip||ip,'');b.innerHTML=GLORY.table([['IP',d.ip],['Type',d.type],['Country',`${d.country||''} ${d.country_code||''}`],['Region',d.region],['City',d.city],['Coordinates',d.latitude!=null?`${d.latitude}, ${d.longitude}`:''],['ISP',d.connection?.isp||''],['ASN',d.connection?.asn||''],['Timezone',d.timezone?.id||'']])}catch(e){b.innerHTML='<p>IP service unavailable or invalid address.</p>'}}
async function runDns(){const d=$('#dnsDomain').value.trim().replace(/^https?:\/\//,'').split('/')[0],t=$('#dnsType').value,b=$('#dnsResult');if(!d)return GLORY.toast('Enter a domain.');b.innerHTML='<p>Resolving…</p>';try{const r=await dnsLookup(d,t);GLORY.addHistory('DNS '+t,d,'');const rows=(r.Answer||[]).map(a=>[a.name,a.data]);b.innerHTML=GLORY.table(rows.length?rows:[['Status','No records returned']])}catch(e){b.innerHTML='<p>DNS service unavailable.</p>'}}
async function runDomain(){const d=$('#domainInput').value.trim().replace(/^https?:\/\//,'').split('/')[0],b=$('#domainResult');if(!d)return GLORY.toast('Enter a domain.');b.innerHTML='<p>Querying RDAP…</p>';try{const r=await rdapDomain(d);GLORY.addHistory('Domain/RDAP',d,'');const ev=(r.events||[]).map(e=>[e.eventAction,GLORY.prettyDate(e.eventDate)]);b.innerHTML=GLORY.table([['Domain',r.ldhName||d],['Status',(r.status||[]).join(', ')],...ev])}catch(e){b.innerHTML='<p>No public RDAP record available.</p>'}}
async function runASN(){let a=$('#asnInput').value.trim().toUpperCase().replace(/^AS/,''),b=$('#asnResult');if(!/^\d+$/.test(a))return GLORY.toast('Enter a valid ASN.');b.innerHTML='<p>Querying…</p>';try{const r=await rdapASN(a);GLORY.addHistory('ASN lookup','AS'+a,'');b.innerHTML=GLORY.table([['ASN','AS'+a],['Name',r.name],['Type',r.type],['Country',r.country]])}catch(e){b.innerHTML='<p>No public RDAP record available.</p>'}}
async function runCrt(){const d=$('#crtDomain').value.trim().replace(/^https?:\/\//,'').split('/')[0],b=$('#crtResult');if(!d)return GLORY.toast('Enter a domain.');b.innerHTML='<p>Searching…</p>';try{const r=await crtSearch(d);GLORY.addHistory('Certificate transparency',d,'');const names=[...new Set(r.flatMap(x=>x.name_value?.split('\n')||[]))].slice(0,80);b.innerHTML=`<p><b>${names.length}</b> names found.</p><div class="link-grid">${names.map(n=>`<a href="https://crt.sh/?q=${encodeURIComponent(n)}" target="_blank" rel="noopener">${GLORY.escape(n)}</a>`).join('')}</div>`}catch(e){b.innerHTML='<p>crt.sh unavailable or rate-limited.</p>'}}
async function runMetadata(){let u=$('#metaUrl').value.trim(),b=$('#metaResult');if(!u)return GLORY.toast('Enter a URL.');if(!/^https?:\/\//.test(u))u='https://'+u;b.innerHTML='<p>Retrieving…</p>';try{const r=await metadataLookup(u),m=r.data||{};GLORY.addHistory('Metadata lookup',u,'');b.innerHTML=GLORY.table([['Title',m.title],['Description',m.description],['Publisher',m.publisher],['Author',m.author],['Language',m.lang],['Canonical URL',m.url]])}catch(e){b.innerHTML='<p>Metadata service unavailable.</p>'}}
async function runDiscord(){const id=$('#discordId').value.trim(),b=$('#discordResult');if(!/^\d{15,21}$/.test(id))return GLORY.toast('Enter a valid Discord ID.');b.innerHTML='<p>Querying…</p>';try{const d=await discordLookup(id);GLORY.addHistory('Discord ID',id,'');b.innerHTML=GLORY.table([['ID',d.id],['Username',d.username],['Global name',d.global_name],['Bot',d.bot?'Yes':'No'],['Created',d.created_at?GLORY.prettyDate(d.created_at):'']])}catch(e){b.innerHTML='<p>Lookup service unavailable.</p>'}}
function runTelegram(){const u=$('#telegramUser').value.trim().replace(/^@/,''),b=$('#telegramResult');if(!/^[A-Za-z0-9_]{4,32}$/.test(u))return GLORY.toast('Enter a valid username.');const url='https://t.me/'+encodeURIComponent(u);b.innerHTML=`<p>Public profile: <a href="${url}" target="_blank" rel="noopener">${url}</a></p>`;GLORY.addHistory('Telegram username',u,url)}
async function runEmail(){const e=$('#emailInput').value.trim(),b=$('#emailResult'),valid=/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e),domain=e.split('@')[1]||'';let mx='Unable to check';if(valid){try{const d=await dnsLookup(domain,'MX');mx=d.Answer?.length?d.Answer.map(a=>a.data).join('; '):'No MX records'}catch(x){}}GLORY.addHistory('Email validation',valid?e:'invalid','');b.innerHTML=GLORY.table([['Syntax',valid?'Valid':'Invalid'],['Domain',domain],['MX records',mx]])}
function runPhone(){const raw=$('#phoneInput').value.trim(),b=$('#phoneResult'),digits=raw.replace(/[^+\d]/g,''),code=Object.keys(COUNTRY_CODES).find(c=>digits.startsWith(c)),national=digits.replace(/^\+?\d{1,4}/,'');GLORY.addHistory('Phone validation',raw,'');b.innerHTML=GLORY.table([['Input',raw],['Digits',digits],['Country code',code?`${code} — likely ${COUNTRY_CODES[code]}`:'Not recognized'],['Normalized',code?`${code} ${national}`:digits]])}
function runAddress(){const line=$('#addressLine').value.trim(),city=$('#addressCity').value.trim(),postal=$('#addressPostal').value.trim(),country=$('#addressCountry').value,b=$('#addressResult'),complete=line&&city&&postal;const sources={US:[['USPS','https://pe.usps.com/'],['NASRC property records','https://www.nasrc.org/']],ID:[['DJP','https://www.pajak.go.id/'],['BPN','https://www.bpn.go.id/']],GB:[['GOV.UK councils','https://www.gov.uk/find-local-council'],['Land Registry','https://www.gov.uk/search-property-information-land-registry']],CA:[['Canada Post','https://www.canadapost-postescanada.ca/']],AU:[['Australia Post','https://auspost.com.au/']]};GLORY.addHistory('Address validation',complete?line:'incomplete','');b.innerHTML=`<p><b>Format:</b> ${complete?'Structurally complete':'Incomplete'}</p><p><b>Normalized:</b> ${GLORY.escape([line,city,postal,country].filter(Boolean).join(', '))}</p><div class="link-grid">${(sources[country]||[]).map(([n,u])=>`<a href="${u}" target="_blank" rel="noopener">${n}</a>`).join('')}</div>`}
function runNameSearch(){const n=$('#nameFull').value.trim(),loc=$('#nameLocation').value.trim(),b=$('#nameResult');if(!n)return GLORY.toast('Enter a name.');const q=encodeURIComponent(n+(loc?' '+loc:''));const links=[['USA.gov','https://www.usa.gov/'],['NCSC court records','https://www.ncsc.org/'],['OpenCorporates',`https://opencorporates.com/companies?q=${q}`],['DuckDuckGo',`https://duckduckgo.com/?q=${q}`],['Internet Archive',`https://archive.org/search?query=${q}`]];GLORY.addHistory('Public name research',n,'');b.innerHTML='<div class="link-grid">'+links.map(([x,u])=>`<a href="${u}" target="_blank" rel="noopener">${x}</a>`).join('')+'</div>'}
