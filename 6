function getCases(){return GLORY.store.get('cases',[])}
function saveCases(c){GLORY.store.set('cases',c)}
function activeCaseId(){return GLORY.store.get('activeCase',null)}
function setActiveCase(id){GLORY.store.set('activeCase',id);renderCases();renderNotes();renderDashboard()}
function createCase(title,tags){if(!title.trim())return GLORY.toast('Enter a case title.');const c=getCases();const x={id:'case_'+Date.now(),title:title.trim(),tags:tags.split(',').map(s=>s.trim()).filter(Boolean),created:GLORY.now(),updated:GLORY.now(),notes:[]};c.unshift(x);saveCases(c);setActiveCase(x.id);GLORY.toast('Case created.')}
function addNote(id,title,body,source){const c=getCases().find(x=>x.id===id);if(!c)return GLORY.toast('Create or select a case.');if(!title.trim()&&!body.trim())return GLORY.toast('Add a title or finding.');c.notes.unshift({title:title.trim()||'Untitled finding',body:body.trim(),source:source.trim(),time:GLORY.now()});c.updated=GLORY.now();saveCases(getCases());renderNotes();renderCases();renderDashboard();GLORY.toast('Note saved.')}
function deleteCase(id){if(!confirm('Delete this case?'))return;saveCases(getCases().filter(c=>c.id!==id));if(activeCaseId()===id)GLORY.store.set('activeCase',null);renderCases();renderNotes();renderDashboard()}
function exportReport(id){const c=getCases().find(x=>x.id===id);if(!c)return;const l=['# GLORY ORG Research Report','',`**Case:** ${c.title}`,'',`**Created:** ${GLORY.prettyDate(c.created)}`,'',`**Updated:** ${GLORY.prettyDate(c.updated)}`,'','## Findings',''];if(!c.notes.length)l.push('_No findings recorded._');c.notes.forEach((n,i)=>{l.push(`### ${i+1}. ${n.title}`,'',`**Recorded:** ${GLORY.prettyDate(n.time)}`,'',n.body||'','');if(n.source)l.push(`**Source:** ${n.source}`,'')});const b=new Blob([l.join('\n')],{type:'text/markdown'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=c.title.replace(/[^a-z0-9]+/gi,'-').toLowerCase()+'-report.md';a.click()}
function renderCases(){const c=getCases(),list=$('#caseList');if(!list)return;list.innerHTML=c.length?'':'<div class="card"><p>No cases yet.</p></div>';c.forEach(x=>{const e=document.createElement('div');e.className='case-card';e.innerHTML=`<h4>${GLORY.escape(x.title)}</h4><small>${GLORY.prettyDate(x.updated)} · ${x.notes.length} findings</small><div class="case-actions"><button class="btn" data-open="${x.id}">Open</button><button class="btn" data-export="${x.id}">Export</button><button class="btn danger" data-delete="${x.id}">Delete</button></div>`;list.appendChild(e)});const d=$('#dashboardCases');if(d){d.innerHTML=c.length?'':'<p>No saved cases.</p>';c.slice(0,6).forEach(x=>{const e=document.createElement('div');e.className='case-card';e.innerHTML=`<h4>${GLORY.escape(x.title)}</h4><small>${x.notes.length} findings</small>`;d.appendChild(e)})}const s=$('#noteCase');if(s)s.innerHTML='<option value="">Select a case…</option>'+c.map(x=>`<option value="${x.id}" ${x.id===activeCaseId()?'selected':''}>${GLORY.escape(x.title)}</option>`).join('')}
function renderNotes(){const c=getCases().find(x=>x.id===activeCaseId()),b=$('#notesList');if(!b)return;b.innerHTML=c?'':'<div class="card"><p>Select or create a case.</p></div>';if(!c)return;c.notes.forEach(n=>{const e=document.createElement('div');e.className='note';e.innerHTML=`<h4>${GLORY.escape(n.title)}</h4><time>${GLORY.prettyDate(n.time)}</time><p>${GLORY.escape(n.body)}</p>${n.source?`<a href="${GLORY.escape(n.source)}" target="_blank" rel="noopener">${GLORY.escape(n.source)}</a>`:''}`;b.appendChild(e)})}
