:root{--bg:#070b12;--panel:#0d1420;--panel-2:#111a29;--line:#1e2b3f;--text:#e6edf7;--muted:#8b9bb4;--accent:#22d3ee;--accent-2:#6366f1;--good:#34d399;--radius:14px}
*{box-sizing:border-box}html,body{margin:0;padding:0}
body{background:radial-gradient(1000px 600px at 80% -10%,rgba(99,102,241,.16),transparent),var(--bg);color:var(--text);font:15px/1.55 Inter,system-ui,sans-serif}
.app{display:flex;min-height:100vh}
.sidebar{width:262px;flex:0 0 262px;background:linear-gradient(180deg,#0b111c,#080d16);border-right:1px solid var(--line);padding:20px 14px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:18px}
.brand{display:flex;gap:12px;align-items:center}.logo{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#04121a}
.brand h1{font-size:18px;margin:0;letter-spacing:.06em}.made-by{margin:2px 0 0;font-size:11px;color:var(--muted)}
nav{display:flex;flex-direction:column;gap:6px}
.nav-btn{text-align:left;background:transparent;border:1px solid transparent;color:var(--muted);padding:10px 12px;border-radius:10px;cursor:pointer}
.nav-btn:hover{color:var(--text);background:var(--panel-2)}
.nav-btn.active{color:#fff;background:linear-gradient(90deg,rgba(34,211,238,.16),rgba(99,102,241,.12));border-color:rgba(34,211,238,.28)}
.sidebar-footer{margin-top:auto;font-size:11px;color:var(--muted);display:flex;align-items:center;gap:8px}
.status-dot{width:8px;height:8px;border-radius:50%;background:var(--good);box-shadow:0 0 10px var(--good)}
.main{flex:1;min-width:0;padding:18px 22px 50px}
.topbar{display:flex;gap:10px;align-items:center;margin-bottom:20px}
#globalSearch{flex:1;background:var(--panel);border:1px solid var(--line);color:var(--text);padding:11px 14px;border-radius:12px;outline:none}
.icon-btn{background:var(--panel);border:1px solid var(--line);color:var(--text);width:42px;height:42px;border-radius:12px;cursor:pointer;display:none}
.view{display:none}.view.active{display:block;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.page-head h2{margin:0 0 5px}.page-head p{margin:0 0 18px;color:var(--muted)}
.card{background:linear-gradient(180deg,var(--panel),#0a101a);border:1px solid var(--line);border-radius:var(--radius);padding:18px;margin-bottom:16px}
.card h3{margin:0 0 8px}.card p{color:var(--muted);margin:0 0 12px}
.grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:16px}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:16px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px}
.stat b{display:block;font-size:26px}.stat span{color:var(--muted);font-size:12px;text-transform:uppercase}
input,select,textarea{width:100%;background:#0a1120;border:1px solid var(--line);color:var(--text);padding:10px 12px;border-radius:10px;outline:none;margin-bottom:10px;font:inherit}
.row{display:flex;gap:10px}.row>*{flex:1;min-width:0}
.btn{border:1px solid var(--line);background:var(--panel-2);color:var(--text);padding:10px 14px;border-radius:10px;cursor:pointer;font-weight:600}
.btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent-2));border:0;color:#04121a}
.btn.danger{background:rgba(248,113,113,.14);border-color:rgba(248,113,113,.4);color:#fca5a5}
.preview{display:block;margin-top:10px;padding:10px;background:#050a12;border:1px dashed var(--line);border-radius:10px;color:var(--accent);word-break:break-all}
.result{margin-top:12px}.result table{width:100%;border-collapse:collapse}
.result td{padding:7px 8px;border-bottom:1px solid var(--line);vertical-align:top}.result td:first-child{color:var(--muted);width:36%}
.link-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;margin-top:12px}
.link-grid a{display:block;padding:9px 10px;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;color:var(--text);text-decoration:none;font-size:13px}
.activity-list{list-style:none;margin:0;padding:0;color:var(--muted);font-size:13px}
.activity-list li{padding:8px 0;border-bottom:1px solid var(--line)}
.case-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.case-card{background:var(--panel-2);border:1px solid var(--line);border-radius:12px;padding:14px}
.case-actions{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap}.case-actions .btn{padding:6px 9px;font-size:12px}
.notes-list{display:grid;gap:10px;margin-top:14px}
.note{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;padding:12px}
.notice{border-color:rgba(251,191,36,.35);background:linear-gradient(180deg,rgba(251,191,36,.08),var(--panel))}
.toast{position:fixed;right:18px;bottom:18px;background:var(--panel);border:1px solid var(--accent);padding:11px 15px;border-radius:12px;opacity:0;pointer-events:none;transition:.2s;z-index:99}
.toast.show{opacity:1}
.quick-tools{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}
.quick-tools button{background:var(--panel-2);border:1px solid var(--line);color:var(--text);padding:10px;border-radius:10px;cursor:pointer}
@media(max-width:860px){.sidebar{position:fixed;left:0;top:0;z-index:50;transform:translateX(-105%);transition:.22s}.sidebar.open{transform:none}.icon-btn{display:block}.main{padding:14px}.row{flex-direction:column}}
